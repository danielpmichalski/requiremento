{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs.schema.json",
  "title": "Requirements specification",
  "description": "Source data of specs.html: one file per ticket, e.g. LIB-101.json. Text fields are Markdown: paragraphs, `-` and `1.` lists, pipe tables, `###` headings, **bold**, *italic* and `code`. IDs of the spec (AC-01, RULE-LOAN-03, ...) and of reference data items (MEM-1, BK-2, ...) are linked automatically. [[term-id]] links a term of the terms file and shows its current name.",
  "type": "object",
  "required": [
    "meta",
    "sections",
    "terms",
    "dataKinds",
    "data",
    "stories",
    "ruleGroups",
    "rules",
    "examples",
    "acceptanceCriteria",
    "testCases",
    "limitations",
    "assumptions",
    "risks",
    "questions",
    "decisions",
    "withdrawn",
    "changelog"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "key",
        "title",
        "fullTitle",
        "version",
        "date",
        "status",
        "approvedBy",
        "approvedOn",
        "related",
        "precedence"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "Ticket key, e.g. of your issue tracker."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short title, shown in the page header."
        },
        "fullTitle": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the specification, raised when the product owner gets a new version to approve."
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "description": "Document status, e.g. \"Draft\", \"Awaiting product owner approval\", \"Approved\"."
        },
        "approvedBy": {
          "type": "string"
        },
        "approvedOn": {
          "type": "string"
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Repository path or URL."
              }
            }
          }
        },
        "precedence": {
          "type": "string"
        }
      }
    },
    "sections": {
      "description": "The page in reading order. A section has free text (body, then after) and can show one collection between them.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string"
          },
          "list": {
            "enum": [
              "meta",
              "terms",
              "data",
              "rules",
              "acceptanceCriteria",
              "testCases",
              "limitations",
              "assumptions",
              "risks",
              "traceability",
              "questions",
              "decisions",
              "withdrawn"
            ]
          },
          "after": {
            "type": "string",
            "description": "Text shown after the collection."
          }
        }
      }
    },
    "terms": {
      "description": "Ids of the terms.json terms this spec relies on. The definitions live only in terms.json.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "dataKinds": {
      "description": "Kinds of reference data (books, members, loans, ...): the columns of their table in the section with list \"data\".",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "title",
          "columns"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Name of one item, e.g. \"Version\"."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Heading of the table, e.g. \"Versions\"."
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Column names; the keys of an item's values."
          },
          "derived": {
            "type": "array",
            "description": "Computed columns: the items of another kind whose column mentions this item, e.g. the loans of a member.",
            "items": {
              "type": "object",
              "required": [
                "title",
                "kind",
                "column"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "$ref": "#/$defs/slug"
                },
                "column": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "data": {
      "description": "Reference data the rules, examples and test cases use, e.g. MEM-1 or BK-2. Their IDs are linked wherever they are mentioned, also in other data items.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/dataId"
          },
          "kind": {
            "$ref": "#/$defs/slug",
            "description": "Id of a data kind."
          },
          "values": {
            "type": "object",
            "description": "Column name of the kind -> Markdown text. Empty columns are left out.",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "testOnly": {
            "const": true,
            "description": "Used only by the test cases, not by the examples."
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "text",
          "setup",
          "readiness"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "\"As a ..., I want ..., so that ...\""
          },
          "setup": {
            "type": "string",
            "description": "Common setup of the story's scenarios."
          },
          "readiness": {
            "type": "string",
            "description": "e.g. \"Ready\", \"Ready (decided)\"."
          }
        }
      }
    },
    "ruleGroups": {
      "description": "Groups of business rules, in display order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "story",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "e.g. \"6.1\"."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "story": {
            "type": "string",
            "description": "Story id, or empty."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "description": "Business rules (example mapping). Every rule has at least one example.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "group": {
            "type": "string",
            "description": "Id of a rule group."
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "examples": {
      "description": "Concrete examples of a rule. Every example is used by at least one AC.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "rule": {
            "type": "string",
            "description": "Id of the rule it illustrates."
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "story",
          "title",
          "status",
          "statusNote",
          "rules",
          "examples",
          "description",
          "scenarios",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "story": {
            "type": "string",
            "description": "Story id."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/acStatus"
          },
          "statusNote": {
            "type": "string",
            "description": "What is missing, or where a limitation is described."
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "description": "Text before the scenarios."
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One Gherkin \"Scenario:\" or \"Scenario Outline:\" each, with its steps and Examples table."
          },
          "notes": {
            "type": "string",
            "description": "Text after the scenarios."
          }
        }
      }
    },
    "testCases": {
      "description": "Test cases derived from the ACs, e.g. by the quality-assurance agents.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "acs",
          "status",
          "steps",
          "automation",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "acs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Ids of the ACs the test case covers."
          },
          "status": {
            "enum": [
              "draft",
              "ready",
              "passed",
              "failed",
              "blocked"
            ]
          },
          "steps": {
            "type": "string",
            "description": "Gherkin or Markdown."
          },
          "automation": {
            "type": "string",
            "description": "Path of the automated test, or empty for a manual test."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "description": "Known limitations: accepted deviations from the rules.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "text",
          "affects",
          "followUp"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "followUp": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "affects"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risks": {
      "description": "Acceptance risks. The level is likelihood × impact: 6 to 9 High, 3 to 4 Medium, 1 to 2 Low.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "likelihood",
          "impact",
          "acs",
          "testApproach"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "likelihood": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "acs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testApproach": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "blocks",
          "askedTo",
          "status",
          "resolution"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "string"
          },
          "askedTo": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "description": "Decision log: what the product owner decided, oldest first.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "text",
          "refs"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "withdrawn": {
      "description": "IDs that must not be reused. A range is written \"F-LOAN-01..F-LOAN-42\".",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ids",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changelog": {
      "description": "Changes of this file. Append-only, oldest first.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "author",
          "action",
          "ref",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "$ref": "#/$defs/dateTime"
          },
          "author": {
            "type": "string"
          },
          "action": {
            "enum": [
              "added",
              "changed",
              "withdrawn",
              "deleted",
              "decision"
            ]
          },
          "ref": {
            "type": "string",
            "description": "Id of the item, a section id, or empty for the whole file."
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+(-[A-Z]+)*-[0-9]+[a-z]?$",
      "description": "Stable ID, e.g. AC-09a or RULE-LOAN-03. Never changed or reused; withdraw it instead."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2}))?$",
      "description": "Date, or date and time with UTC offset, e.g. 2026-10-19T14:32+02:00."
    },
    "acStatus": {
      "description": "draft: not decided yet. pending: decided, not yet implemented. implemented: built and verified. known-limitation: accepted deviation. target: non-binding target.",
      "enum": [
        "draft",
        "pending",
        "implemented",
        "known-limitation",
        "target"
      ]
    },
    "dataId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)*$",
      "description": "ID of a reference data item, e.g. MEM-1, BK-2, CP-3a1 or MX. Must not look like an ID of the spec."
    }
  }
}
