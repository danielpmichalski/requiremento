{
  "name": "requiremento",
  "version": "0.1.0",
  "description": "Living requirements as JSON: shared terms, one requirements file per ticket, viewers/editors and checkers. No dependencies.",
  "keywords": [
    "requirements",
    "specification-by-example",
    "acceptance-criteria",
    "gherkin",
    "ubiquitous-language",
    "domain-driven-design",
    "bdd",
    "json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielpmichalski/requiremento.git"
  },
  "homepage": "https://github.com/danielpmichalski/requiremento#readme",
  "bugs": {
    "url": "https://github.com/danielpmichalski/requiremento/issues"
  },
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "requiremento": "bin/requiremento.mjs"
  },
  "files": [
    "bin",
    "lib",
    "pages",
    "schemas"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check:example": "cd examples/library && node ../../bin/requiremento.mjs check"
  }
}
